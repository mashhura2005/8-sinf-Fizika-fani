<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elektr zaryadlarining o‘zaro ta’siri. Kulon qonuni</title>
<style>
*{box-sizing:border-box}
:root{
  --blue:#2563eb;--blue2:#1d4ed8;--green:#16a34a;--red:#dc2626;
  --text:#172033;--muted:#64748b;--bg:#f5f8fc;--card:#fff;--line:#dbe3ee;
  --soft:#eef5ff;--warn:#fff7ed;
}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
header{background:#fff;border-bottom:1px solid var(--line);padding:28px 16px;text-align:center}
header h1{margin:0 0 8px;font-size:clamp(24px,4vw,38px);color:#173b75}
header p{margin:0;color:var(--muted);font-size:16px}
.container{max-width:1100px;margin:auto;padding:18px}
.section{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;margin:18px 0;box-shadow:0 4px 14px rgba(30,50,80,.05)}
h2{margin-top:0;color:#173b75;font-size:clamp(21px,3vw,29px)}
h3{color:#244a82}
.plan{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}
.plan div{background:var(--soft);border-radius:10px;padding:12px;font-weight:700;text-align:center}
.theory{background:#f8fafc;border-left:4px solid var(--blue);padding:14px;border-radius:8px}
ul{padding-left:22px}
.formula{font-size:clamp(25px,5vw,40px);font-weight:700;text-align:center;padding:20px;background:#f8fbff;border:1px solid #cfe0ff;border-radius:12px;margin:15px 0}
.note{color:var(--muted)}
.sim-panel{border:2px solid #b9d1f8;border-radius:14px;padding:18px;background:#fafdff}
.control-group{padding:14px 0;border-bottom:1px solid var(--line)}
.control-group:last-child{border-bottom:0}
.control-title{font-weight:700;margin-bottom:9px;color:#234a80}
.charge-row{display:flex;flex-wrap:wrap;gap:16px;justify-content:center}
.charge-choice{display:flex;align-items:center;gap:8px}
.btn{border:0;border-radius:9px;background:var(--blue);color:white;padding:11px 15px;font-size:15px;font-weight:700;cursor:pointer;transition:.15s}
.btn:hover{background:var(--blue2);transform:translateY(-1px)}
.btn.secondary{background:#475569}
.btn.green{background:var(--green)}
.btn.red{background:var(--red)}
.btn.light{background:#e8eef7;color:#203552}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
button{font-family:inherit}
.sim-area{position:relative;height:300px;margin:18px 0;border:1px solid var(--line);border-radius:14px;background:linear-gradient(#fff,#f5f9ff);overflow:hidden}
.track{position:absolute;left:7%;right:7%;top:50%;height:4px;background:#cbd5e1}
.ball{position:absolute;top:50%;width:74px;height:74px;margin:-37px 0 0 -37px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;color:white;box-shadow:0 7px 16px rgba(0,0,0,.18);transition:left .35s ease}
.ball.one{background:#2563eb}.ball.two{background:#dc2626}
.arrow{position:absolute;top:calc(50% - 70px);font-size:42px;font-weight:800;transition:left .35s ease,transform .35s ease}
.arrow.a1{color:#2563eb}.arrow.a2{color:#dc2626}
.result{text-align:center;font-size:24px;font-weight:800;padding:12px;border-radius:10px;margin-top:10px}
.result.attract{background:#ecfdf5;color:#15803d}.result.repel{background:#fef2f2;color:#b91c1c}
.distance-line{display:flex;align-items:center;gap:10px}
input[type=range]{width:100%;accent-color:var(--blue)}
.distance-value{font-size:18px;font-weight:700;min-width:70px;text-align:center}
.calc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.field label{display:block;font-weight:700;margin-bottom:5px}
input[type=text],input[type=number]{width:100%;padding:11px 12px;border:1px solid #cbd5e1;border-radius:9px;font-size:16px;outline:none}
input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #dbeafe}
.error{margin-top:13px;padding:11px;border-radius:9px;background:#fef2f2;color:#b91c1c;display:none;font-weight:700}
.success{margin-top:13px;padding:14px;border-radius:9px;background:#ecfdf5;color:#166534;display:none}
.steps{margin-top:15px}
.step{padding:13px;margin:8px 0;background:#f8fafc;border-left:4px solid var(--blue);border-radius:7px;display:none}
.final-answer{font-size:29px;font-weight:800;text-align:center;padding:18px;background:#ecfdf5;color:#166534;border-radius:12px;margin-top:12px}
.example-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.example{border:1px solid var(--line);border-radius:12px;padding:15px;background:#fff}
.mini-animation{height:115px;border-radius:10px;background:#f7fbff;position:relative;overflow:hidden;margin-bottom:10px}
.hair{position:absolute;left:50%;bottom:20px;width:110px;height:50px;transform:translateX(-50%);background:repeating-linear-gradient(90deg,#333 0 3px,transparent 3px 10px);border-radius:50%}
.comb{position:absolute;left:25%;top:35px;font-size:35px;animation:combMove 2s infinite alternate ease-in-out}
.paper{position:absolute;right:20%;top:45px;font-size:28px;animation:paperMove 1.5s infinite alternate ease-in-out}
.balloon{position:absolute;left:50%;top:28px;transform:translateX(-50%);font-size:45px;animation:ballMove 1.4s infinite alternate ease-in-out}
.clothes{position:absolute;left:50%;top:28px;transform:translateX(-50%);font-size:43px;animation:clothMove 1.2s infinite alternate ease-in-out}
@keyframes combMove{from{left:22%}to{left:55%}}
@keyframes paperMove{from{right:18%}to{right:42%}}
@keyframes ballMove{from{top:25px}to{top:42px}}
@keyframes clothMove{from{transform:translateX(-50%) rotate(-5deg)}to{transform:translateX(-50%) rotate(5deg)}}
.solve-step{display:none;padding:13px;margin:8px 0;background:#f8fafc;border-radius:8px;border-left:4px solid #16a34a}
.test{border:1px solid var(--line);padding:15px;border-radius:12px;margin:12px 0;background:#fff}
.option{display:block;padding:8px;margin:6px 0;border:1px solid #e2e8f0;border-radius:8px;cursor:pointer}
.option:hover{background:#f8fafc}
.test-result{display:none;margin-top:15px;padding:15px;border-radius:10px;background:#eef5ff;font-weight:700}
.answer-mark{font-weight:800;margin-left:8px}
.thanks{text-align:center;font-size:clamp(25px,5vw,40px);font-weight:800;color:#173b75;padding:40px 10px}
.small{font-size:14px;color:var(--muted)}
@media(max-width:750px){
  .container{padding:10px}.section{padding:16px}
  .plan,.calc-grid,.example-grid{grid-template-columns:1fr}
  .sim-area{height:260px}
  .ball{width:60px;height:60px;margin:-30px 0 0 -30px;font-size:23px}
  .arrow{font-size:34px}
  .distance-line{gap:5px}
  .btn{padding:10px 11px}
}
</style>
</head>
<body>
<header>
  <h1>Elektr zaryadlarining o‘zaro ta’siri. Kulon qonuni</h1>
  <p>8-sinf Fizika — interaktiv ta’limiy simulyatsiya</p>
</header>

<main class="container">
<section class="section">
  <h2>Reja</h2>
  <div class="plan">
    <div>1. Elektr zaryadlarining o‘zaro ta’siri</div>
    <div>2. Kulon qonuni va uning formulasi</div>
    <div>3. Kulon qonunining qo‘llanilishi</div>
  </div>
</section>

<section class="section">
<h2>1. Elektr zaryadlarining o‘zaro ta’siri</h2>
<div class="theory">
<p>Elektr zaryadlari ikki xil bo‘ladi:</p>
<ul><li><b>Musbat (+)</b></li><li><b>Manfiy (−)</b></li></ul>
<p><b>Bir xil ishorali</b> zaryadlar bir-birini <b>itaradi</b>.</p>
<p><b>Har xil ishorali</b> zaryadlar bir-birini <b>tortadi</b>.</p>
</div>

<h3>Interaktiv simulyatsiya</h3>
<div class="sim-panel">
<div class="control-group">
  <div class="control-title">1. ZARYADLARNI TANLASH</div>
  <div class="charge-row">
    <div class="charge-choice"><b>Zaryad 1:</b>
      <button class="btn light" id="q1plus">+</button>
      <button class="btn light" id="q1minus">−</button>
    </div>
    <div class="charge-choice"><b>Zaryad 2:</b>
      <button class="btn light" id="q2plus">+</button>
      <button class="btn light" id="q2minus">−</button>
    </div>
  </div>
</div>

<div class="control-group">
  <div class="control-title">2. MASOFA</div>
  <div class="distance-line">
    <button class="btn light" id="distMinus">−</button>
    <input id="distSlider" type="range" min="0.10" max="0.50" step="0.01" value="0.20">
    <button class="btn light" id="distPlus">+</button>
    <span class="distance-value" id="distText">0,20 m</span>
  </div>
</div>

<div class="control-group">
  <div class="control-title">3. ANIMATSIYA</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button class="btn green" id="startBtn">▶ BOSHLASH</button>
    <button class="btn secondary" id="pauseBtn">⏸ PAUZA</button>
    <button class="btn red" id="resetBtn">↻ QAYTA O‘RNATISH</button>
  </div>
</div>

<div class="control-group">
  <div class="control-title">4. NATIJA</div>
  <div id="simResult" class="result attract">TORTISHISH</div>
</div>
</div>

<div class="sim-area" id="simArea">
  <div class="track"></div>
  <div id="ball1" class="ball one" style="left:28%">+</div>
  <div id="ball2" class="ball two" style="left:72%">+</div>
  <div id="arrow1" class="arrow a1">→</div>
  <div id="arrow2" class="arrow a2">←</div>
</div>
<p class="small">Zaryadlar va masofa o‘zgartirilganda sharlar, kuch yo‘nalishi va simulyatsiya natijasi avtomatik moslashadi.</p>
</section>

<section class="section">
<h2>2. Kulon qonuni va uning formulasi</h2>
<p>Vakuumda ikki nuqtaviy zaryadning o‘zaro ta’sir kuchi Kulon qonuni bilan aniqlanadi:</p>
<div class="formula">F = k · |q₁ · q₂| / r²</div>
<ul>
<li><b>F</b> — o‘zaro ta’sir kuchi, N;</li>
<li><b>q₁</b> — birinchi zaryad, C;</li>
<li><b>q₂</b> — ikkinchi zaryad, C;</li>
<li><b>r</b> — zaryadlar orasidagi masofa, m;</li>
<li><b>k = 9 · 10⁹ N·m²/C²</b>.</li>
</ul>

<h3>Interaktiv hisoblagich</h3>
<div class="calc-grid">
  <div class="field"><label for="q1Input">q₁ = μC</label><input id="q1Input" type="text" inputmode="decimal" placeholder="Masalan: 2"></div>
  <div class="field"><label for="q2Input">q₂ = μC</label><input id="q2Input" type="text" inputmode="decimal" placeholder="Masalan: 4"></div>
  <div class="field"><label for="rInput">r = m</label><input id="rInput" type="text" inputmode="decimal" placeholder="Masalan: 0,2"></div>
</div>
<br>
<button class="btn" id="calcBtn">HISOBLASH</button>
<div id="calcError" class="error"></div>
<div id="calcSuccess" class="success"></div>
<div id="calcSteps" class="steps">
  <div class="step" id="cstep1"></div>
  <div class="step" id="cstep2"></div>
  <div class="step" id="cstep3"></div>
  <div class="step" id="cstep4"></div>
  <div class="step" id="cstep5"></div>
</div>
<div id="calcFinal" class="final-answer" style="display:none"></div>
</section>

<section class="section">
<h2>3. Kulon qonunining qo‘llanilishi</h2>
<p>Kulon qonuni fizik masalalarni yechishda, laboratoriya tajribalarida, elektrostatik hodisalarni tushuntirishda va elektrlangan jismlarning o‘zaro ta’sirini o‘rganishda qo‘llaniladi.</p>
<ul>
<li><b>Fizik masalalarni yechish:</b> zaryadlar orasidagi kuchni hisoblash.</li>
<li><b>Laboratoriya tajribalari:</b> zaryadlarning o‘zaro ta’sirini kuzatish.</li>
<li><b>Elektrostatik hodisalar:</b> zaryadlangan jismlarning tortishishi va itarilishi.</li>
<li><b>Elektrlangan jismlar:</b> zaryadlarning ta’sirini tahlil qilish.</li>
<li><b>Kundalik hayot:</b> ishqalanish natijasida jismlarning elektrlanishi.</li>
</ul>

<div class="example-grid">
<div class="example">
  <h3>1. Elektrlangan taroq</h3>
  <div class="mini-animation"><div class="comb">🪮</div><div class="paper">📄 📄</div></div>
  <p>Taroq sochga ishqalanganda elektrlanadi va mayda qog‘oz bo‘laklarini tortishi mumkin.</p>
</div>
<div class="example">
  <h3>2. Shar va soch</h3>
  <div class="mini-animation"><div class="balloon">🎈</div><div class="hair"></div></div>
  <p>Shar sochga ishqalanganda zaryadlanadi va soch tolalariga elektrostatik ta’sir ko‘rsatadi.</p>
</div>
<div class="example">
  <h3>3. Elektrlangan kiyim</h3>
  <div class="mini-animation"><div class="clothes">👕</div></div>
  <p>Kiyimlar ishqalanish orqali zaryadlanib, bir-birini tortishi yoki ayrim holatlarda itarishi mumkin.</p>
</div>
<div class="example">
  <h3>4. Elektrostatik hodisalar</h3>
  <div class="mini-animation"><div style="position:absolute;left:50%;top:32px;transform:translateX(-50%);font-size:45px;animation:ballMove 1s infinite alternate">⚡</div></div>
  <p>Elektrlanish va zaryadlarning o‘zaro ta’siri ko‘plab elektrostatik hodisalarning asosidir.</p>
</div>
</div>
</section>

<section class="section">
<h2>Masala yechish</h2>
<div class="theory">
<b>Masala:</b><br>
q₁ = 2 μC, q₂ = 4 μC, r = 0,2 m.<br>
Zaryadlar orasidagi kuchni toping.
</div>
<br>
<button class="btn green" id="solveBtn">YECHISH</button>
<div id="solveSteps">
  <div class="solve-step" id="s1"><b>1. Berilgan:</b><br>q₁ = 2 μC; q₂ = 4 μC; r = 0,2 m.</div>
  <div class="solve-step" id="s2"><b>2. Formula:</b><br>F = k · |q₁q₂| / r²</div>
  <div class="solve-step" id="s3"><b>3. Birliklarni almashtirish:</b><br>q₁ = 2 · 10⁻⁶ C; q₂ = 4 · 10⁻⁶ C.</div>
  <div class="solve-step" id="s4"><b>4. Formulaga qo‘yish:</b><br>F = 9 · 10⁹ · (2 · 10⁻⁶ · 4 · 10⁻⁶) / (0,2)²</div>
  <div class="solve-step" id="s5"><b>5. Hisoblash:</b><br>F = 1,8 N</div>
  <div class="final-answer" id="solveFinal" style="display:none">F = 1,8 N</div>
</div>
</section>

<section class="section">
<h2>Test — bilimni tekshirish</h2>
<p class="note">Javoblarni belgilang. To‘g‘ri javoblar test yakunigacha ko‘rsatilmaydi.</p>
<div class="test" data-answer="b">
  <b>1. Bir xil ishorali zaryadlar qanday ta’sirlashadi?</b>
  <label class="option"><input type="radio" name="t1" value="a"> Tortishadi</label>
  <label class="option"><input type="radio" name="t1" value="b"> Itarishadi</label>
  <label class="option"><input type="radio" name="t1" value="c"> Ta’sirlashmaydi</label>
  <span class="answer-mark"></span>
</div>
<div class="test" data-answer="c">
  <b>2. Kulon qonunidagi r nimani bildiradi?</b>
  <label class="option"><input type="radio" name="t2" value="a"> Zaryad miqdorini</label>
  <label class="option"><input type="radio" name="t2" value="b"> Kuchni</label>
  <label class="option"><input type="radio" name="t2" value="c"> Zaryadlar orasidagi masofani</label>
  <span class="answer-mark"></span>
</div>
<div class="test" data-answer="a">
  <b>3. Kulon doimiysining qiymati qaysi?</b>
  <label class="option"><input type="radio" name="t3" value="a"> 9 · 10⁹ N·m²/C²</label>
  <label class="option"><input type="radio" name="t3" value="b"> 9 · 10⁶ N·m²/C²</label>
  <label class="option"><input type="radio" name="t3" value="c"> 3 · 10⁸ N·m²/C²</label>
  <span class="answer-mark"></span>
</div>
<div class="test" data-answer="b">
  <b>4. Masofa 2 marta oshsa, Kulon kuchi qanday o‘zgaradi?</b>
  <label class="option"><input type="radio" name="t4" value="a"> 2 marta oshadi</label>
  <label class="option"><input type="radio" name="t4" value="b"> 4 marta kamayadi</label>
  <label class="option"><input type="radio" name="t4" value="c"> O‘zgarmaydi</label>
  <span class="answer-mark"></span>
</div>
<div class="test" data-answer="c">
  <b>5. Har xil ishorali zaryadlar qanday ta’sirlashadi?</b>
  <label class="option"><input type="radio" name="t5" value="a"> Itarishadi</label>
  <label class="option"><input type="radio" name="t5" value="b"> Ta’sirlashmaydi</label>
  <label class="option"><input type="radio" name="t5" value="c"> Tortishadi</label>
  <span class="answer-mark"></span>
</div>
<button class="btn" id="checkTest">NATIJANI TEKSHIRISH</button>
<div id="testResult" class="test-result"></div>
</section>

<div class="thanks">E’tiboringiz uchun rahmat!</div>
</main>

<script>
"use strict";
const $ = id => document.getElementById(id);

let q1sign = 1, q2sign = 1;
let distance = 0.20;
let animating = false;
let animationId = null;
let phase = 0;

function fmt(n, digits=2){
  return Number(n).toFixed(digits).replace(/\.?0+$/,"").replace(".",",");
}
function setChargeVisual(){
  $("ball1").textContent = q1sign>0 ? "+" : "−";
  $("ball2").textContent = q2sign>0 ? "+" : "−";
  const same = q1sign === q2sign;
  $("simResult").textContent = same ? "ITARISHISH" : "TORTISHISH";
  $("simResult").className = "result " + (same ? "repel" : "attract");
  updateSimulation(false);
}
function updateDistance(){
  distance = parseFloat($("distSlider").value);
  $("distText").textContent = fmt(distance,2) + " m";
  updateSimulation(false);
}
function setActive(btn){
  [ $("q1plus"),$("q1minus"),$("q2plus"),$("q2minus") ].forEach(b=>b.classList.add("light"));
  btn.classList.remove("light");
}
$("q1plus").onclick=()=>{q1sign=1;setActive($("q1plus"));setChargeVisual()};
$("q1minus").onclick=()=>{q1sign=-1;setActive($("q1minus"));setChargeVisual()};
$("q2plus").onclick=()=>{q2sign=1;setActive($("q2plus"));setChargeVisual()};
$("q2minus").onclick=()=>{q2sign=-1;setActive($("q2minus"));setChargeVisual()};
$("distSlider").oninput=updateDistance;
$("distMinus").onclick=()=>{$("distSlider").value=Math.max(.10,+(parseFloat($("distSlider").value)-.01).toFixed(2));updateDistance()};
$("distPlus").onclick=()=>{$("distSlider").value=Math.min(.50,+(parseFloat($("distSlider").value)+.01).toFixed(2));updateDistance()};

function updateSimulation(animated=true){
  const same=q1sign===q2sign;
  const center=50;
  const gap=18 + ((distance-.10)/.40)*22;
  let left1=center-gap, left2=center+gap;
  if(animated && animating){
    if(same){left1 += Math.sin(phase)*2;left2 -= Math.sin(phase)*2}
    else {left1 -= Math.sin(phase)*2;left2 += Math.sin(phase)*2}
  }
  $("ball1").style.left=left1+"%";
  $("ball2").style.left=left2+"%";
  const mid=(left1+left2)/2;
  const d=Math.max(1,left2-left1);
  $("arrow1").style.left=(same?left1-7:left1+4)+"%";
  $("arrow2").style.left=(same?left2-1:left2-5)+"%";
  $("arrow1").textContent=same?"←":"→";
  $("arrow2").textContent=same?"→":"←";
  $("arrow1").style.transform="translateX(-50%)";
  $("arrow2").style.transform="translateX(-50%)";
}
function animate(){
  if(!animating)return;
  phase += .06;
  updateSimulation(true);
  animationId=requestAnimationFrame(animate);
}
$("startBtn").onclick=()=>{
  if(!animating){animating=true;animate();}
};
$("pauseBtn").onclick=()=>{
  animating=false;
  if(animationId)cancelAnimationFrame(animationId);
  updateSimulation(false);
};
$("resetBtn").onclick=()=>{
  animating=false;
  if(animationId)cancelAnimationFrame(animationId);
  q1sign=1;q2sign=1;distance=.20;phase=0;
  $("distSlider").value=".20";
  $("distText").textContent="0,20 m";
  setChargeVisual();
  [ $("q1plus"),$("q2plus") ].forEach(setActive);
};

function parseValue(raw){
  return raw.trim().replace(",",".");
}
function validateAndCalculate(){
  const err=$("calcError"), ok=$("calcSuccess"), steps=$("calcSteps"), final=$("calcFinal");
  err.style.display="none";ok.style.display="none";final.style.display="none";
  steps.querySelectorAll(".step").forEach(x=>{x.style.display="none";x.innerHTML=""});
  const a=parseValue($("q1Input").value), b=parseValue($("q2Input").value), c=parseValue($("rInput").value);
  if(!a||!b||!c){err.textContent="Iltimos, barcha qiymatlarni kiriting.";err.style.display="block";return}
  if(!/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(a) ||
     !/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(b) ||
     !/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(c)){
    err.textContent="Qiymatni faqat son ko‘rinishida kiriting.";err.style.display="block";return
  }
  const q1=Number(a),q2=Number(b),r=Number(c);
  if(!Number.isFinite(q1)||!Number.isFinite(q2)||!Number.isFinite(r)){
    err.textContent="Kiritilgan qiymatni tekshiring.";err.style.display="block";return
  }
  if(r===0){err.textContent="Masofa 0 ga teng bo‘lishi mumkin emas. r > 0 bo‘lishi kerak.";err.style.display="block";return}
  if(r<0){err.textContent="Masofa manfiy bo‘lishi mumkin emas.";err.style.display="block";return}
  if(Math.abs(q1)>1e12||Math.abs(q2)>1e12||r>1e9||r<1e-15){
    err.textContent="Kiritilgan qiymatni tekshiring.";err.style.display="block";return
  }
  const F=9e9*Math.abs((q1*1e-6)*(q2*1e-6))/(r*r);
  if(!Number.isFinite(F)){err.textContent="Kiritilgan qiymatni tekshiring.";err.style.display="block";return}
  const fstr=Number(F.toPrecision(6)).toString().replace(".",",");
  $("cstep1").innerHTML="<b>1. Berilgan:</b><br>q₁ = "+fmt(q1,6)+" μC = "+q1+" · 10⁻⁶ C<br>q₂ = "+fmt(q2,6)+" μC = "+q2+" · 10⁻⁶ C<br>r = "+fmt(r,6)+" m";
  $("cstep2").innerHTML="<b>2. Formula:</b><br>F = k · |q₁q₂| / r²";
  $("cstep3").innerHTML="<b>3. Qiymatlarni qo‘yish:</b><br>F = 9 · 10⁹ · ("+q1+" · 10⁻⁶ · "+q2+" · 10⁻⁶) / ("+fmt(r,6)+")²";
  $("cstep4").innerHTML="<b>4. Hisoblash:</b><br>F = "+fstr+" N";
  $("cstep5").innerHTML="<b>5. YAKUNIY JAVOB:</b><br>F = "+fstr+" N";
  $("calcSteps").querySelectorAll(".step").forEach(x=>x.style.display="block");
  final.textContent="F = "+fstr+" N";
  final.style.display="block";
  ok.textContent="Hisoblash muvaffaqiyatli bajarildi.";
  ok.style.display="block";
}
$("calcBtn").onclick=validateAndCalculate;

let solveTimer=null;
$("solveBtn").onclick=()=>{
  ["s1","s2","s3","s4","s5"].forEach(id=>$(id).style.display="none");
  $("solveFinal").style.display="none";
  let i=0;
  clearInterval(solveTimer);
  solveTimer=setInterval(()=>{
    if(i<5){$("s"+(i+1)).style.display="block";i++}
    else{$("solveFinal").style.display="block";clearInterval(solveTimer)}
  },600);
};

$("checkTest").onclick=()=>{
  const tests=[...document.querySelectorAll(".test")];
  let score=0;
  tests.forEach((t,i)=>{
    const answer=t.dataset.answer;
    const selected=t.querySelector("input:checked");
    const mark=t.querySelector(".answer-mark");
    if(selected && selected.value===answer){score++;mark.textContent="✓ To‘g‘ri";mark.style.color="#15803d"}
    else{mark.textContent="✗ Noto‘g‘ri";mark.style.color="#b91c1c"}
  });
  const percent=Math.round(score/tests.length*100);
  $("testResult").textContent=`${tests.length} ta savoldan ${score} tasi to‘g‘ri — ${percent}%`;
  $("testResult").style.display="block";
};

setChargeVisual();
setActive($("q1plus"));setActive($("q2plus"));
